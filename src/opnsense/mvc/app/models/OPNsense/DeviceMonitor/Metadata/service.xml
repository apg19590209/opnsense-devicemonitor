<model>
    <service>
        <name>DeviceMonitor</name>
        <description>Device Monitor - network device tracking</description>
        <classname>OPNsense\DeviceMonitor\DeviceMonitor</classname>
        <controller>OPNsense\DeviceMonitor\Api\ServiceController</controller>
        <pidfile>/var/run/devicemonitor.pid</pidfile>
        <commands>
            <start>devicemonitor start</start>
            <stop>devicemonitor stop</stop>
            <restart>devicemonitor restart</restart>
        </commands>
    </service>
</model>