msgstr "Otevřené porty TCP"

msgid "Search IP, MAC or name"
msgstr "Hledat IP, MAC nebo název"

msgid "TCP ports, e.g. 22,443"
msgstr "Porty TCP, např. 22,443"

msgid "All results"
msgstr "Všechny výsledky"

