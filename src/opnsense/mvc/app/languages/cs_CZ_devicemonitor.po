# ============================================
# [settings.volt] Nastavení - 4 taby
# ============================================


#: settings.volt - tab 1 název
msgid "Email Notifications"
msgstr "Email notifikace"

#: settings.volt - tab 2 název
msgid "Webhook Notifications"
msgstr "Webhook notifikace"

#: settings.volt - tab 3 název
msgid "Other Settings"
msgstr "Ostatní nastavení"

#: settings.volt - tab 4 název
msgid "About"
msgstr "O pluginu"

#: settings.volt - tab 1 info text (lokalizovaný!)
msgid "Configure email notifications for new devices on the network"
msgstr "Nastavení emailových notifikací pro nová zařízení v síti"

#: settings.volt - tab 2 info text
msgid "Configure webhook notifications for new devices on the network"
msgstr "Nastavení webhook notifikací pro nová zařízení v síti"

#: settings.volt - tab 1: checkbox
msgid "Enable Email"
msgstr "Zapnout email"

#: settings.volt - tab 1: label nad polem email příjemce
msgid "Email Recipient"
msgstr "Email příjemce"

#: settings.volt - tab 1: nápověda pod polem email příjemce
msgid "Where to send notifications"
msgstr "Kam odesílat notifikace"

#: settings.volt - tab 1: label nad polem email odesílatele
msgid "Email Sender"
msgstr "Email odesílatele"

#: settings.volt - tab 1: nápověda pod polem email odesílatele
msgid "From address"
msgstr "Adresa odesílatele"

#: settings.volt - tab 1: nadpis SMTP upozornění
msgid "Important - SMTP Configuration"
msgstr "Důležité - SMTP konfigurace"

#: settings.volt - tab 1: text SMTP upozornění (s HTML tagem)
msgid "Plugin uses <strong>sendmail (Postfix)</strong> to send emails"
msgstr "Plugin používá <strong>sendmail (Postfix)</strong> pro odesílání emailů"

#: settings.volt - tab 1: text SMTP upozornění (s HTML tagem a cestou)
msgid "Must be configured in: <strong>System > Settings > Notifications > SMTP</strong>"
msgstr "Musí být nakonfigurováno v: <strong>System > Settings > Notifications > SMTP</strong>"

#: settings.volt - tab 1: tlačítko pro test emailu
msgid "Test Email"
msgstr "Test Email"

#: settings.volt - tab 2: checkbox
msgid "Enable Webhook"
msgstr "Zapnout webhook"

#: settings.volt - tab 2: label nad polem webhook URL
msgid "Webhook URL"
msgstr "Webhook URL"

#: settings.volt - tab 2: tlačítko pro test webhooku
msgid "Send Test"
msgstr "Odeslat test"

#: settings.volt - tab 1+2: sekce VLAN filtr notifikací (label)
msgid "Notify for interfaces"
msgstr "Notifikovat pro rozhraní"

#: settings.volt - tab 1+2: nápověda pod VLAN filtrem
msgid "Leave empty to receive notifications from all interfaces"
msgstr "Ponech prázdné pro notifikace ze všech rozhraní"

#: settings.volt - tab 1+2: zobrazí se když nejsou načteny rozhraní
msgid "No interfaces found"
msgstr "Žádná rozhraní nenalezena"

#: settings.volt - tab 3: checkbox
msgid "Enable Monitoring"
msgstr "Zapnout monitoring"

#: settings.volt - tab 3: nápověda u checkboxu monitoring
msgid "Enable automatic network monitoring"
msgstr "Zapne automatické sledování nových zařízení"

#: settings.volt - tab 3: label nad polem interval
msgid "Scan Interval"
msgstr "Interval skenování"

#: settings.volt - tab 3: jednotka za polem interval
msgid "seconds"
msgstr "sekund"

#: settings.volt - tab 3: nápověda pod polem interval
msgid "Seconds between scans (60-3600)"
msgstr "Sekund mezi skeny (60-3600)"

#: settings.volt - tab 4: popis pluginu
msgid "OPNsense plugin for monitoring network devices using the native hostwatch database."
msgstr "Plugin pro OPNsense pro sledování síťových zařízení pomocí nativní hostwatch databáze."

#: settings.volt - tab 4: tabulka info - položka
msgid "Author"
msgstr "Autor"

#: settings.volt - tab 4: tabulka info - položka
msgid "GitHub Repository"
msgstr "GitHub repozitář"

#: settings.volt - tab 4: tabulka info - položka
msgid "License"
msgstr "Licence"

#: settings.volt - tab 4: tabulka info - minimální verze OPNsense
msgid "Requires OPNsense"
msgstr "Vyžaduje OPNsense"

#: settings.volt - Apply tlačítko na každém tabu
msgid "Apply"
msgstr "Použít"

#: settings.volt - spinner text při ukládání (Apply button)
msgid "Saving..."
msgstr "Ukládám..."

#: settings.volt - toast po úspěšném uložení konfigurace
msgid "Configuration saved"
msgstr "Konfigurace uložena"

#: settings.volt - toast při chybě uložení konfigurace
msgid "Error saving configuration"
msgstr "Chyba při ukládání konfigurace"

#: settings.volt - toast po odeslání testovacího emailu
msgid "Test email sent to"
msgstr "Testovací email odeslán na"

#: settings.volt - toast při chybě odeslání testovacího emailu
msgid "Failed to send email"
msgstr "Email se nepodařilo odeslat"

#: settings.volt - alert: uživatel nevyplnil email před testem
msgid "Please enter and save recipient email first"
msgstr "Nejprve vyplň emailovou adresu příjemce"

#: settings.volt - alert: uživatel nevyplnil webhook URL
msgid "Enter webhook URL first"
msgstr "Nejprve vyplň webhook URL"

#: settings.volt - inline status při odesílání test webhooku
msgid "Sending..."
msgstr "Odesílám..."

#: settings.volt - inline status po odeslání test webhooku
msgid "Test sent!"
msgstr "Test odeslán!"

#: settings.volt - inline status při chybě test webhooku
msgid "Failed"
msgstr "Chyba"

#: settings.volt - verze pluginu (za Device Monitor v záhlaví)
msgid "Using OPNsense hostwatch database"
msgstr "Využívá hostwatch databázi OPNsense"

#: settings.volt - Status sloupec / hodnota
msgid "Status"
msgstr "Stav"
# ============================================
# [settings.volt] Email transport
# ============================================

#: settings.volt - email transport
msgid "Email delivery method"
msgstr "Způsob odesílání e-mailu"

#: settings.volt - email transport
msgid "Local Sendmail / Postfix"
msgstr "Lokální Sendmail / Postfix"

#: settings.volt - email transport
msgid "Direct SMTP (built into Device Monitor)"
msgstr "Přímé SMTP (součást Device Monitoru)"

#: settings.volt - email transport
msgid "Choose the mail transport that matches your OPNsense installation"
msgstr "Vyberte způsob odesílání odpovídající vaší instalaci OPNsense"

#: settings.volt - email transport
msgid "Uses /usr/local/sbin/sendmail. This is suitable when a local mailer such as the os-postfix plugin is installed and configured."
msgstr "Používá /usr/local/sbin/sendmail. Vhodné, pokud je nainstalován a nakonfigurován lokální poštovní systém, například plugin os-postfix."

#: settings.volt - email transport
msgid "Direct SMTP uses the Python standard library and does not require Postfix, sendmail or Monit."
msgstr "Přímé SMTP používá standardní knihovnu Pythonu a nevyžaduje Postfix, sendmail ani Monit."

#: settings.volt - email transport
msgid "SMTP Server"
msgstr "SMTP server"

#: settings.volt - email transport
msgid "SMTP Port"
msgstr "SMTP port"

#: settings.volt - email transport
msgid "Encryption"
msgstr "Šifrování"

#: settings.volt - email transport
msgid "None"
msgstr "Žádné"

#: settings.volt - email transport
msgid "SMTP Username"
msgstr "SMTP uživatelské jméno"

#: settings.volt - email transport
msgid "Leave empty if the SMTP server does not require authentication"
msgstr "Ponechte prázdné, pokud SMTP server nevyžaduje ověření"

#: settings.volt - email transport
msgid "SMTP Password"
msgstr "SMTP heslo"

#: settings.volt - email transport
msgid "The current email settings are saved before the test is sent"
msgstr "Aktuální nastavení e-mailu se před odesláním testu uloží"

#: settings.volt - email transport
msgid "Please enter recipient email first"
msgstr "Nejprve zadejte e-mail příjemce"

